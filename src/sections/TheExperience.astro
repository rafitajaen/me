---
import { Icon } from "astro-icon/components";
import portfolio from "../data/portfolio.json";
const { experience } = portfolio;
---

<section id="experience" class="flex flex-col gap-6 hidden">
    <ul class="flex flex-col gap-8">
        {
            experience.map((item) => (
                <li class="group hover:translate-x-1 transition-all duration-300 ease-out flex flex-col gap-4 sm:gap-0">
                    <div class="flex flex-col-reverse sm:flex-row sm:items-baseline justify-between">
                        <div class="flex items-center gap-2">
                            {item.icon && (
                                <Icon
                                    name={item.icon}
                                    size="18"
                                    class={
                                        item.icon === "sibarita"
                                            ? "rounded-sm"
                                            : ""
                                    }
                                />
                            )}
                            <h4 class="text-sm font-medium text-zinc-700 dark:text-zinc-400">
                                {item.company}
                            </h4>
                        </div>

                        <span class="text-xs text-zinc-400 dark:text-zinc-500">
                            {item.location}
                        </span>
                    </div>

                    <div class="flex flex-col-reverse sm:flex-row sm:items-baseline justify-between">
                        <h3 class="flex flex-wrap gap-2 text-md font-medium">
                            {item.role}

                            {item.badge && (
                                <div class="flex items-center gap-1 rounded-md border-green-300 bg-green-500/10 px-2 py-1 text-xs w-fit">
                                    <div class="size-2 rounded-full bg-green-500 animate-pulse" />
                                    {item.badge}
                                </div>
                            )}
                        </h3>
                        <span class="text-xs text-zinc-400 dark:text-zinc-500">
                            {item.date}
                        </span>
                    </div>

                    <p class="text-sm text-zinc-500 dark:text-zinc-400 my-2">
                        {item.description}
                    </p>

                    {item.previousRole && (
                        <>
                            <div class="flex flex-col-reverse sm:flex-row sm:items-baseline justify-between mt-2">
                                <h3 class="flex flex-wrap gap-2 text-md font-medium">
                                    {item.previousRole.title}
                                </h3>
                                <span class="text-xs text-zinc-400 dark:text-zinc-500">
                                    {item.previousRole.date}
                                </span>
                            </div>

                            <p class="text-sm text-zinc-500 dark:text-zinc-400 my-2">
                                {item.previousRole.description}
                            </p>
                        </>
                    )}

                    <span class="text-xs text-zinc-400 font-mono">
                        {item.stack}
                    </span>
                </li>
            ))
        }
    </ul>
</section>
